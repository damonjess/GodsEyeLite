<?xml version="1.0" encoding="utf-8"?>
<!--
  A native top bar, then the globe below it.

  The status text and the ion-key button used to be FrameLayout children drawn
  ON TOP of the WebView, which put them on top of the page's own HUD (the title,
  the pack chips and RESET VIEW also live in the top strip of the globe). Giving
  the bar its own row means the two top areas can never overlap.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF07070B"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF0A0A0F"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="6dp"
        android:paddingRight="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="2"
            android:text="@string/status_loading"
            android:textColor="#FF35E0C8"
            android:textSize="11sp" />

        <Button
            android:id="@+id/keyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:minWidth="0dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/ion_key_button"
            android:textSize="11sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The Cesium globe renders here. -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Cesium ion token entry. -->
        <LinearLayout
            android:id="@+id/settingsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_margin="20dp"
            android:background="#F00A0A0F"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ion_key_title"
                android:textColor="#FF35E0C8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ionTokenInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/ion_key_hint"
                android:inputType="text"
                android:maxLines="4"
                android:textColor="#FFE8E8F0"
                android:textColorHint="#FF6A6A80"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ion_key_help"
                android:textColor="#FF9A9AB0"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save" />

                <Button
                    android:id="@+id/closeKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/cancel" />
            </LinearLayout>
        </LinearLayout>

        <!-- Selected camera frame. -->
        <LinearLayout
            android:id="@+id/cameraPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="#F00A0A0F"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <!-- TfL jamcams publish a short clip, so the panel can show either a
                 still or video in the same slot: exactly one is visible.
                 No android:background here: TextureView throws on inflation if it
                 is given a background drawable. The panel's own opaque fill shows
                 through instead. -->
            <TextureView
                android:id="@+id/frameVideo"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/frameImage"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:background="#FF12121A"
                android:contentDescription="@string/frame_loading"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/cameraTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFE8E8F0"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/cameraCredit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FF9A9AB0"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/reloadFrame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reload_frame" />

                <Button
                    android:id="@+id/closeFrame"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/close" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
